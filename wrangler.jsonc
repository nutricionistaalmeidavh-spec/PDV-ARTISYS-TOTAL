{
  // Cloudflare Git integration: project root is this repository.
  // IMPORTANT: this name must match the Worker already created in Cloudflare.
  "name": "pdv-artisys-total",
  "main": "apps/api/src/worker.mjs",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  // Additive hostname: same Worker, same D1 and API routes. Keep workers.dev
  // enabled because the ArtiSys Payments bridge still calls that URL.
  // Cloudflare provisions this hostname's proxied DNS and TLS at deploy.
  "routes": [
    { "pattern": "pdv.artisys.dev", "custom_domain": true }
  ],
  // Workers Logs persist invocation metadata/errors; never emit passwords, tokens or customer payloads.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // API remains read-only / locked while the SaaS is not provisioned for customers.
  "vars": {
    "AUTH_ENABLED": "true",
    "EMAIL_FROM": "welcome@artisys.dev",
    "EMAIL_PUBLIC_BASE_URL": "https://pdv.artisys.dev",
    "REGISTRATION_ENABLED": "true",
    "SAAS_ENTITLEMENTS_ENABLED": "true",
    "TENANT_SELF_SIGNUP_ENABLED": "false",
    "TRUST_CF_CONNECTING_IP": "true",
    "MFA_ENABLED": "false",
    "EMAIL_VERIFICATION_REQUIRED": "false",
    "TELEMETRY_ANALYTICS_ENABLED": "true",
    "ARTISYS_BILLING_ENABLED": "true",
    "ARTISYS_PLATFORM_CENTRAL_ENABLED": "false",
    "ARTISYS_PLATFORM_BRIDGE_ENABLED": "true",
    "ARTISYS_PAYMENTS_URL": "https://pagamentos-artisys-central.nutricionistaalmeidavh.workers.dev",
    "ARTISYS_PDV_MONTHLY_OFFER_ID": "pdv-total-saas-mensal",
    "ARTISYS_PDV_YEARLY_OFFER_ID": "pdv-total-saas-anual"
  },
  // Wrangler 4 auto-provisions missing resource IDs; do not invent UUIDs.
  // Do not ever bind the desktop licensing D1 database here.
  "send_email": [
    { "name": "EMAIL" }
  ],
  "analytics_engine_datasets": [
    { "binding": "PDV_TELEMETRY_ANALYTICS", "dataset": "pdv_total_optin_telemetry" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdv-artisys-total",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  // R2 bucket is provisioned separately from D1, without account API tokens.
  // It remains unused until the canonical attachment/backup feature exists.
  "r2_buckets": [
    { "binding": "FILES" }
  ]
}
