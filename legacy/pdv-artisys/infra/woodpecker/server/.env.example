# URL publica do Woodpecker. Para webhooks do GitHub, use uma URL acessivel externamente.
WOODPECKER_HOST=https://ci.seu-dominio.com

# GitHub OAuth App (callback: https://ci.seu-dominio.com/authorize)
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Mesmo segredo usado pelo Agent Windows.
# Gere um valor aleatorio forte antes de subir o servidor.
WOODPECKER_AGENT_SECRET=

# Restringe administracao e sincronizacao ao owner ArtiSys atual.
WOODPECKER_ADMIN=nutricionistaalmeidavh-spec
WOODPECKER_REPO_OWNERS=nutricionistaalmeidavh-spec
