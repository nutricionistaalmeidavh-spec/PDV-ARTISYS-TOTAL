{
  "name": "16-consultar-estoque",
  "title": "Consultar estoque",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "base"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-cadastros",
      "holdMs": 450
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 650
    },
    {
      "action": "waitFor",
      "selector": "#inventory-master-actions",
      "name": "estoque-pronto",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 250
    },
    {
      "action": "fill",
      "selector": "#ops-inventory-search",
      "name": "buscar-estoque",
      "value": "Produto Tutorial",
      "holdMs": 450
    },
    {
      "action": "expectText",
      "selector": "#ops-inventory-body",
      "name": "saldo-visivel",
      "expected": "Produto Tutorial",
      "timeoutMs": 10000,
      "holdMs": 900
    }
  ]
}
