{
  "name": "20-fazer-devolucao",
  "title": "Fazer devolução",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "return"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='post-sale']",
      "name": "abrir-pos-venda",
      "holdMs": 350
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='returns']",
      "name": "abrir-devolucoes",
      "holdMs": 550
    },
    {
      "action": "waitFor",
      "selector": "[data-return-sales-list] [data-return-sale]:first-child",
      "name": "venda-disponivel",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "[data-return-sales-list] [data-return-sale]:first-child",
      "name": "selecionar-venda",
      "holdMs": 450
    },
    {
      "action": "check",
      "selector": "[data-return-sale-detail] [data-return-check]",
      "name": "selecionar-item",
      "timeoutMs": 10000,
      "holdMs": 250
    },
    {
      "action": "fill",
      "selector": "#return-reason",
      "name": "motivo-devolucao",
      "value": "Devolução tutorial",
      "holdMs": 300
    },
    {
      "action": "click",
      "selector": "#confirm-return",
      "name": "confirmar-devolucao",
      "holdMs": 650
    },
    {
      "action": "expectText",
      "selector": "#returns-status",
      "name": "devolucao-concluida",
      "expected": "concluída",
      "timeoutMs": 15000,
      "holdMs": 1000
    }
  ]
}
