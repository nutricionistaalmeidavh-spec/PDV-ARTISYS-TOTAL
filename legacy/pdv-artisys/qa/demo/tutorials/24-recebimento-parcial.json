{
  "name": "24-recebimento-parcial",
  "title": "Fazer recebimento parcial",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "purchase-ordered"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-cadastros",
      "holdMs": 450
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 650
    },
    {
      "action": "waitFor",
      "selector": "#inventory-master-actions",
      "name": "estoque-pronto",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "#enterprise-depth-entry [data-open='purchases']",
      "name": "abrir-compras",
      "holdMs": 650
    },
    {
      "action": "waitFor",
      "selector": "#enterprise-po-form",
      "name": "compras-prontas",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "[data-list] [data-action='receive-po']",
      "name": "abrir-recebimento",
      "holdMs": 450
    },
    {
      "action": "fill",
      "selector": "[data-purchase-receive-qty]",
      "name": "quantidade-parcial",
      "value": "4",
      "holdMs": 400
    },
    {
      "action": "click",
      "selector": "[data-purchase-receive-submit]",
      "name": "confirmar-parcial",
      "holdMs": 800
    },
    {
      "action": "expectText",
      "selector": "[data-list]",
      "name": "recebimento-parcial",
      "expected": "Recebido parcialmente",
      "timeoutMs": 10000,
      "holdMs": 1000
    }
  ]
}
