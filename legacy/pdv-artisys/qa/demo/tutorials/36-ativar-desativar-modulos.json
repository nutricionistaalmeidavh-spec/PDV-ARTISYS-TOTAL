{
  "name": "36-ativar-desativar-modulos",
  "title": "Ativar ou desativar módulos",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "modules"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='settings']",
      "name": "abrir-configuracoes",
      "holdMs": 650
    },
    {
      "action": "waitFor",
      "selector": "#settings-hub",
      "name": "configuracoes-prontas",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "#settings-hub [data-settings-category='modules']",
      "name": "abrir-modulos",
      "holdMs": 450
    },
    {
      "action": "waitFor",
      "selector": "[data-module-toggle='FOOD']",
      "name": "modulos-prontos",
      "state": "visible",
      "timeoutMs": 12000,
      "holdMs": 250
    },
    {
      "action": "check",
      "selector": "[data-module-toggle='FOOD']",
      "name": "ativar-alimentacao",
      "timeoutMs": 10000,
      "holdMs": 650
    },
    {
      "action": "expectVisible",
      "selector": "[data-module-toggle='FOOD']",
      "name": "modulo-ativo",
      "timeoutMs": 10000,
      "holdMs": 900
    }
  ]
}
