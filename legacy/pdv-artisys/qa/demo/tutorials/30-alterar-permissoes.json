{
  "name": "30-alterar-permissoes",
  "title": "Alterar permissões",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "permissions"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='access']",
      "name": "abrir-acessos",
      "holdMs": 550
    },
    {
      "action": "click",
      "selector": "[data-access-tab='profiles']",
      "name": "abrir-perfis",
      "holdMs": 450
    },
    {
      "action": "click",
      "selector": "[data-new-profile]",
      "name": "novo-perfil",
      "holdMs": 400
    },
    {
      "action": "fill",
      "selector": "[data-profile-form] input[name='name']",
      "name": "nome-perfil",
      "value": "Supervisor Tutorial",
      "holdMs": 260
    },
    {
      "action": "click",
      "selector": "[data-profile-next]",
      "name": "continuar-permissoes",
      "holdMs": 450
    },
    {
      "action": "check",
      "selector": "[data-profile-form] input[name='permission'][value='devices.pair']",
      "name": "selecionar-permissao",
      "timeoutMs": 10000,
      "holdMs": 350
    },
    {
      "action": "click",
      "selector": "[data-profile-next]",
      "name": "revisar-perfil",
      "holdMs": 450
    },
    {
      "action": "click",
      "selector": "[data-profile-save]",
      "name": "salvar-perfil",
      "holdMs": 700
    },
    {
      "action": "expectText",
      "selector": ".access-center-page",
      "name": "perfil-criado",
      "expected": "Supervisor Tutorial",
      "timeoutMs": 10000,
      "holdMs": 900
    }
  ]
}
