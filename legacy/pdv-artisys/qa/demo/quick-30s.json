{
  "name": "quick-30s",
  "title": "ArtiSys PDV — demonstração rápida",
  "durationTargetSec": 30,
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "fill",
      "selector": "#auth-overlay input[type='password']",
      "name": "senha-demo",
      "valueFromEnv": "ARTISYS_QA_DEMO_PASSWORD"
    },
    {
      "action": "click",
      "text": "Criar administrador",
      "name": "criar-admin-demo",
      "exact": true
    },
    {
      "action": "fill",
      "selector": "#auth-overlay input:not([type='password'])",
      "name": "usuario-admin",
      "value": "admin"
    },
    {
      "action": "fill",
      "selector": "#auth-overlay input[type='password']",
      "name": "senha-login",
      "valueFromEnv": "ARTISYS_QA_DEMO_PASSWORD"
    },
    {
      "action": "click",
      "text": "Entrar",
      "name": "entrar",
      "exact": true
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "autenticado",
      "state": "hidden",
      "timeoutMs": 15000,
      "holdMs": 1200
    },
    {
      "action": "screenshot",
      "name": "abertura",
      "holdMs": 600
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "produtos-hub",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='products']",
      "name": "produtos",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "estoque-hub",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "estoque",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[aria-label='Início']",
      "name": "voltar-inicio-1",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "[data-home-route='checkout']",
      "name": "balcao",
      "holdMs": 3800
    },
    {
      "action": "click",
      "selector": "button[aria-label='Início']",
      "name": "voltar-inicio-2",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "[data-home-route='cash']",
      "name": "caixa",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[aria-label='Início']",
      "name": "voltar-inicio-3",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "button[data-route='financial-management']",
      "name": "relatorios-hub",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='reports']",
      "name": "relatorios",
      "holdMs": 3000
    },
    {
      "action": "click",
      "selector": "button[aria-label='Início']",
      "name": "encerramento-home",
      "holdMs": 2200
    },
    {
      "action": "screenshot",
      "name": "encerramento",
      "holdMs": 500
    }
  ]
}
