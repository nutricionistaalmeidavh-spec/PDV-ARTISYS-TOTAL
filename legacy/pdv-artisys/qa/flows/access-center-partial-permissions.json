{
  "name": "access-center-partial-permissions",
  "title": "ArtiSys PDV — Central de Acessos com permissões parciais",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "authenticateLocalQa",
      "name": "entrar-admin",
      "timeoutMs": 15000
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "admin-autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/users",
      "method": "POST",
      "expectedStatus": 201,
      "name": "seed-gerente-parcial",
      "body": {
        "id": "qa-access-manager",
        "username": "qa-access-manager",
        "name": "Gerente QA Acessos",
        "profileId": "profile-manager",
        "password": "QaAccessManager-12345!",
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/access/profiles",
      "method": "POST",
      "expectedStatus": 201,
      "name": "seed-perfil-leitura-pessoas",
      "body": {
        "id": "qa-profile-people-readonly",
        "name": "Consulta de pessoas",
        "permissions": [
          "users.view"
        ]
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/users",
      "method": "POST",
      "expectedStatus": 201,
      "name": "seed-usuario-leitura-pessoas",
      "body": {
        "id": "qa-people-reader",
        "username": "qa-people-reader",
        "name": "Consulta Pessoas QA",
        "profileId": "qa-profile-people-readonly",
        "password": "QaPeopleReader-12345!",
        "active": true
      }
    },
    {
      "action": "click",
      "selector": "#operator-button",
      "name": "abrir-operador-admin",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#logout-button",
      "name": "sair-admin",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#login-form",
      "name": "login-gerente-pronto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='username']",
      "value": "qa-access-manager",
      "name": "gerente-usuario"
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='password']",
      "value": "QaAccessManager-12345!",
      "name": "gerente-senha"
    },
    {
      "action": "click",
      "selector": "#login-form button[type='submit']",
      "name": "entrar-gerente",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "gerente-autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "expectVisible",
      "selector": "#sidebar-nav button[data-route='access']",
      "name": "gerente-ve-central",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#sidebar-nav button[data-route='access']",
      "name": "gerente-abre-central",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".access-center-page",
      "name": "gerente-central-carregada",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "expectVisible",
      "selector": "button[data-access-tab='people']",
      "name": "gerente-tab-pessoas",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "button[data-access-tab='profiles']",
      "name": "gerente-sem-tab-perfis",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": "button[data-access-tab='devices']",
      "name": "gerente-tab-dispositivos",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "button[data-access-tab='security']",
      "name": "gerente-sem-tab-seguranca",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": "[data-new-person]",
      "name": "gerente-pode-criar-pessoa",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": "tr:has-text('Gerente QA Acessos') [data-edit-person]",
      "name": "gerente-pode-editar-pessoa",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-profile-select]",
      "name": "gerente-sem-atribuicao-perfil",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "[data-new-person]",
      "name": "gerente-nova-pessoa",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#modal-root [data-person-form]",
      "name": "gerente-modal-pessoa",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#modal-root select[name='profileId']",
      "name": "gerente-modal-sem-perfil",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#modal-root input[name='name']",
      "value": "Operador criado pelo gerente",
      "name": "gerente-novo-nome"
    },
    {
      "action": "fill",
      "selector": "#modal-root input[name='email']",
      "value": "operador-gerente@example.com",
      "name": "gerente-novo-email"
    },
    {
      "action": "fill",
      "selector": "#modal-root input[name='username']",
      "value": "operador-gerente",
      "name": "gerente-novo-usuario"
    },
    {
      "action": "fill",
      "selector": "#modal-root input[name='password']",
      "value": "QaOperadorGerente-12345!",
      "name": "gerente-nova-senha"
    },
    {
      "action": "click",
      "selector": "#modal-root [data-person-form] button[type='submit']",
      "name": "gerente-criar-pessoa",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#modal-root",
      "name": "gerente-modal-fechado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": "#route-content",
      "expected": "Operador criado pelo gerente",
      "name": "gerente-pessoa-criada",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "tr:has-text('Operador criado pelo gerente') [data-edit-person]",
      "name": "gerente-editar-pessoa",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#modal-root input[name='name']",
      "value": "Operador editado pelo gerente",
      "name": "gerente-editar-nome"
    },
    {
      "action": "click",
      "selector": "#modal-root [data-person-form] button[type='submit']",
      "name": "gerente-salvar-edicao",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#modal-root",
      "name": "gerente-edicao-fechada",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": "#route-content",
      "expected": "Operador editado pelo gerente",
      "name": "gerente-pessoa-editada",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "#operator-button",
      "name": "abrir-operador-gerente",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#logout-button",
      "name": "sair-gerente",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#login-form",
      "name": "login-leitor-pronto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='username']",
      "value": "qa-people-reader",
      "name": "leitor-usuario"
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='password']",
      "value": "QaPeopleReader-12345!",
      "name": "leitor-senha"
    },
    {
      "action": "click",
      "selector": "#login-form button[type='submit']",
      "name": "entrar-leitor",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "leitor-autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "expectVisible",
      "selector": "#sidebar-nav button[data-route='access']",
      "name": "leitor-ve-central",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#sidebar-nav button[data-route='access']",
      "name": "leitor-abre-central",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".access-center-page",
      "name": "leitor-central-carregada",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "expectVisible",
      "selector": "button[data-access-tab='people']",
      "name": "leitor-tab-pessoas",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "button[data-access-tab='profiles']",
      "name": "leitor-sem-tab-perfis",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "button[data-access-tab='devices']",
      "name": "leitor-sem-tab-dispositivos",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "button[data-access-tab='security']",
      "name": "leitor-sem-tab-seguranca",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-new-person]",
      "name": "leitor-sem-criar-pessoa",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-edit-person]",
      "name": "leitor-sem-editar-pessoa",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-save-profile]",
      "name": "leitor-sem-atribuir-perfil",
      "state": "detached",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "access-center-readonly",
      "fullPage": true
    }
  ]
}
