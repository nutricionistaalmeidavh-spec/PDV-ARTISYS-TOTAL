{
  "name": "public-menu-compact-v2",
  "description": "Captura real do cardápio público Compacto V2 no QR canônico.",
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "compact-bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "authenticateLocalQa",
      "name": "compact-entrar",
      "timeoutMs": 15000
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "compact-autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/products",
      "method": "POST",
      "expectedStatus": 201,
      "name": "compact-seed-produto-1",
      "body": {
        "id": "qa-compact-burger",
        "name": "X-Bacon QA",
        "sku": "QA-COMP-01",
        "salePriceCents": 2790,
        "costCents": 900,
        "trackStock": false,
        "menuEnabled": true,
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/products",
      "method": "POST",
      "expectedStatus": 201,
      "name": "compact-seed-produto-2",
      "body": {
        "id": "qa-compact-fries",
        "name": "Batata Frita QA",
        "sku": "QA-COMP-02",
        "salePriceCents": 1890,
        "costCents": 600,
        "trackStock": false,
        "menuEnabled": true,
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/products",
      "method": "POST",
      "expectedStatus": 201,
      "name": "compact-seed-produto-3",
      "body": {
        "id": "qa-compact-cola",
        "name": "Coca-Cola 350ml QA",
        "sku": "QA-COMP-03",
        "salePriceCents": 700,
        "costCents": 250,
        "trackStock": false,
        "menuEnabled": true,
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/tables",
      "method": "POST",
      "expectedStatus": 201,
      "name": "compact-seed-mesa",
      "body": {
        "id": "qa-compact-table",
        "label": "Mesa 08",
        "capacity": 4,
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/tables/qa-compact-table/open",
      "method": "POST",
      "expectedStatus": 201,
      "name": "compact-abrir-comanda",
      "body": {}
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/public-ordering/tables/qa-compact-table/qr",
      "method": "GET",
      "expectedStatus": 200,
      "name": "compact-gerar-qr",
      "saveAs": {
        "qaCompactMenuUrl": "url"
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/public-ordering/config",
      "method": "PUT",
      "expectedStatus": 200,
      "name": "compact-publicar-layout",
      "body": {
        "menuLayout": "COMPACT"
      }
    },
    {
      "action": "setViewportSize",
      "width": 412,
      "height": 915,
      "name": "compact-viewport"
    },
    {
      "action": "goto",
      "urlFrom": "qaCompactMenuUrl",
      "name": "compact-abrir-cardapio"
    },
    {
      "action": "expectVisible",
      "selector": "html[data-menu-layout=\"compact\"]",
      "name": "compact-layout-aplicado",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": ".product-card",
      "expected": "X-Bacon QA",
      "name": "compact-produto-visivel",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "cardapio-qr-compact-v2",
      "fullPage": true
    },
    {
      "action": "expectNoHorizontalOverflow",
      "name": "compact-sem-overflow",
      "tolerancePx": 4,
      "timeoutMs": 10000
    }
  ]
}
